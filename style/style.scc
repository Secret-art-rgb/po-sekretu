*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#ffffff;
    color:#1f1f1f;
    line-height:1.7;
}

.hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    padding:60px 30px;
}

.background-logo{
    position:absolute;
    top:-40px;
    left:-60px;
    font-size:180px;
    font-weight:900;
    letter-spacing:8px;
    opacity:.05;
    user-select:none;
    z-index:0;
    transform:rotate(-8deg);
}

.background-logo .dark{
    color:#222222;
}

.background-logo .yellow{
    color:#f4c400;
}

.hero-content{
    width:100%;
    max-width:1200px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:70px;
    position:relative;
    z-index:2;
}

.book-cover{
    flex:1;
    display:flex;
    justify-content:center;
}

.book-cover img{
    width:100%;
    max-width:360px;
    border-radius:12px;
    box-shadow:0 18px 40px rgba(0,0,0,.18);
}

.hero-text{
    flex:1;
}

.hero-text h1{
    font-size:54px;
    line-height:1.1;
    color:#222;
    margin-bottom:25px;
}

.subtitle{
    font-size:21px;
    color:#555;
    margin-bottom:40px;
}

.button{
    display:inline-block;
    background:#f4c400;
    color:#222;
    text-decoration:none;
    font-weight:bold;
    padding:18px 36px;
    border-radius:10px;
    transition:.3s;
}

.button:hover{
    background:#d8aa00;
    transform:translateY(-2px);
}
section{
    max-width:1100px;
    margin:90px auto;
    padding:0 30px;
}

section h2{
    font-size:38px;
    color:#222;
    margin-bottom:30px;
    position:relative;
}

section h2::after{
    content:"";
    width:70px;
    height:5px;
    background:#f4c400;
    display:block;
    margin-top:10px;
    border-radius:10px;
}

.about-book p,
.author p{
    font-size:20px;
    color:#444;
    margin-bottom:20px;
}

.reader ul,
.inside ul{
    padding-left:25px;
}

.reader li,
.inside li{
    font-size:20px;
    margin-bottom:14px;
    color:#444;
}

#buy{
    text-align:center;
    padding-bottom:90px;
}

#buy h3{
    font-size:56px;
    color:#222;
    margin:30px 0;
}

footer{
    background:#222;
    color:#fff;
    text-align:center;
    padding:30px;
    font-size:15px;
}

@media (max-width:900px){

.hero-content{
    flex-direction:column;
    text-align:center;
}

.hero-text h1{
    font-size:40px;
}

.subtitle{
    font-size:18px;
}

.background-logo{
    font-size:110px;
    top:20px;
    left:-20px;
}

.book-cover img{
    max-width:280px;
}

section{
    margin:70px auto;
}

section h2{
    font-size:30px;
}

.about-book p,
.author p,
.reader li,
.inside li{
    font-size:18px;
}

#buy h3{
    font-size:42px;
}

.button{
    width:100%;
    max-width:320px;
}

}
