*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#fffdf7;
    color:#222222;
    line-height:1.8;
}

/* =========================
   ФИРМЕННЫЙ ФОН CaShBi
   ========================= */

.hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    padding:70px 35px;
}

.background-logo{
    position:absolute;
    top:-35px;
    left:-45px;
    font-size:210px;
    font-weight:900;
    letter-spacing:10px;
    opacity:.045;
    user-select:none;
    z-index:0;
    transform:rotate(-8deg);
    white-space:nowrap;
}

.background-logo .dark{
    color:#222222;
}

.background-logo .yellow{
    color:#f4c400;
}

/* =========================
   ПЕРВЫЙ ЭКРАН
   ========================= */

.hero-content{
    width:100%;
    max-width:1250px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:80px;
    position:relative;
    z-index:2;
}

.book-cover{
    flex:1;
    display:flex;
    justify-content:center;
}

.book-cover img{
    width:100%;
    max-width:390px;
    border-radius:12px;
    box-shadow:0 20px 45px rgba(0,0,0,.18);
}

.hero-text{
    flex:1;
}

.hero-text h1{
    font-size:58px;
    line-height:1.08;
    color:#222;
    margin-bottom:28px;
}

.subtitle{
    font-size:23px;
    color:#555;
    margin-bottom:42px;
}

/* =========================
   КНОПКА
   ========================= */

.button{
    display:inline-block;
    background:#f4c400;
    color:#222;
    text-decoration:none;
    font-weight:bold;
    font-size:18px;
    padding:18px 38px;
    border-radius:10px;
    transition:.3s;
}

.button:hover{
    background:#d8aa00;
    transform:translateY(-2px);
}

/* =========================
   ОСНОВНЫЕ РАЗДЕЛЫ
   ========================= */

section{
    max-width:1250px;
    margin:100px auto;
    padding:0 45px;
}

section h2{
    font-size:42px;
    line-height:1.2;
    color:#222;
    margin-bottom:34px;
    position:relative;
}

section h2::after{
    content:"";
    width:75px;
    height:5px;
    background:#f4c400;
    display:block;
    margin-top:12px;
    border-radius:10px;
}

/* =========================
   ОСНОВНОЙ ТЕКСТ
   ========================= */

.about-book p,
.author p{
    font-size:22px;
    color:#3f3f3f;
    margin-bottom:24;
max-width:1150px;
}

.reader ul,
.inside ul{
    padding-left:30px;
}

.reader li,
.inside li{
    font-size:22px;
    margin-bottom:16px;
    color:#3f3f3f;
}

/* =========================
   ПОКУПКА
   ========================= */

#buy{
    text-align:center;
    padding-bottom:100px;
}

#buy h3{
    font-size:60px;
    line-height:1.1;
    color:#222;
    margin:35px 0;
}

/* =========================
   FOOTER
   ========================= */

footer{
    background:#222;
    color:#fff;
    text-align:center;
    padding:32px;
    font-size:16px;
}

/* =========================
   ТЕЛЕФОН
   ========================= */

@media (max-width:900px){

    .hero{
        padding:55px 25px;
    }

    .hero-content{
        flex-direction:column;
        text-align:center;
        gap:45px;
    }

    .hero-text h1{
        font-size:43px;
    }

    .subtitle{
        font-size:20px;
    }

    .background-logo{
        font-size:120px;
        top:20px;
        left:-25px;
    }

    .book-cover img{
        max-width:300px;
    }

    section{
        margin:75px auto;
        padding:0 25px;
    }

    section h2{
        font-size:33px;
    }

    .about-book p,
    .author p,
    .reader li,
    .inside li{
        font-size:19px;
        line-height:1.75;
    }

    #buy h3{
        font-size:45px;
    }

    .button{
        width:100%;
        max-width:340px;
    }
}
